# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional Gemini model override (defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# AI_RATE_LIMIT: Maximum AI requests per IP per 5-minute sliding window (default: 60)
AI_RATE_LIMIT=60

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Google Maps JavaScript API key.
# When provided, enables full Google Maps Platform rendering, Satellite/Hybrid tiles, and Advanced Markers.
# If not provided, the application gracefully activates the built-in production-ready offline GIS engine.
GOOGLE_MAPS_API_KEY=""

